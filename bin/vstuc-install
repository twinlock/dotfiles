#!/usr/bin/env python3
"""Install the vstuc debug adapter for nvim-dap's Unity setup.

vstuc is the Unity debug adapter out of Microsoft's VS Code Unity extension. It
isn't on mason and it isn't redistributable, so it can't be vendored in this repo -
this pulls it straight from the marketplace instead:

    vstuc-install                 install/update to the latest published version
    vstuc-install --version 1.3.1 pin a version
    vstuc-install --status        print what's installed
    vstuc-install --force         reinstall even if the version already matches

The extension ships far more than the adapter (a whole node extension, code
analysis, localisation), so only extension/bin lands on disk, flattened to
<dir>/bin. config/nvim/lua/plugins/dap.lua expects exactly that layout.
"""

import argparse
import gzip
import io
import json
import shutil
import subprocess
import sys
import urllib.request
import zipfile
from pathlib import Path

PUBLISHER = "visualstudiotoolsforunity"
EXTENSION = "vstuc"
MARKETPLACE = "https://marketplace.visualstudio.com/_apis/public/gallery"
DEFAULT_DIR = Path.home() / ".local/share/nvim/vstuc"
# vstuc 1.3 is a net10.0 app with rollForward: Major, so any host at or above this
# works and a host below it dies with a bare "You must install or update .NET"
MIN_DOTNET_MAJOR = 10


def fetch(url, data=None, headers=None):
    req = urllib.request.Request(url, data=data, headers=headers or {})
    req.add_header("Accept-Encoding", "gzip")
    with urllib.request.urlopen(req, timeout=120) as resp:
        raw = resp.read()
        if resp.headers.get("Content-Encoding") == "gzip":
            raw = gzip.decompress(raw)
        return raw


def latest_version():
    query = json.dumps(
        {
            "filters": [{"criteria": [{"filterType": 7, "value": f"{PUBLISHER}.{EXTENSION}"}]}],
            "flags": 950,
        }
    ).encode()
    body = fetch(
        f"{MARKETPLACE}/extensionquery",
        data=query,
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json;api-version=7.2-preview.1",
        },
    )
    results = json.loads(body)["results"][0]["extensions"]
    if not results:
        sys.exit(f"marketplace has no extension {PUBLISHER}.{EXTENSION}")
    return results[0]["versions"][0]["version"]


def installed_version(dest):
    stamp = dest / "VERSION"
    return stamp.read_text().strip() if stamp.is_file() else None


def dotnet_hosts():
    """Candidate dotnet hosts, in the order dap.lua picks them."""
    for host in (Path.home() / ".dotnet/dotnet", shutil.which("dotnet")):
        if host and Path(host).is_file():
            yield Path(host)


def best_dotnet_major():
    best = 0
    for host in dotnet_hosts():
        try:
            out = subprocess.run(
                [str(host), "--list-runtimes"], capture_output=True, text=True, timeout=30
            ).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        for line in out.splitlines():
            if line.startswith("Microsoft.NETCore.App "):
                best = max(best, int(line.split()[1].split(".")[0]))
    return best


def install(dest, version):
    url = f"{MARKETPLACE}/publishers/{PUBLISHER}/vsextensions/{EXTENSION}/{version}/vspackage"
    print(f"downloading vstuc {version}")
    payload = fetch(url)

    staging = dest.with_name(dest.name + ".new")
    shutil.rmtree(staging, ignore_errors=True)
    bin_dir = staging / "bin"
    bin_dir.mkdir(parents=True)

    prefix = "extension/bin/"
    extracted = 0
    with zipfile.ZipFile(io.BytesIO(payload)) as vsix:
        for entry in vsix.infolist():
            if entry.is_dir() or not entry.filename.startswith(prefix):
                continue
            # keep the localisation subdirs; the adapter resolves them relative to itself
            out = bin_dir / entry.filename[len(prefix) :]
            out.parent.mkdir(parents=True, exist_ok=True)
            with vsix.open(entry) as src, out.open("wb") as dst:
                shutil.copyfileobj(src, dst)
            extracted += 1

    adapter = bin_dir / "UnityDebugAdapter.dll"
    if not adapter.is_file():
        shutil.rmtree(staging, ignore_errors=True)
        sys.exit(f"vsix had no {prefix}UnityDebugAdapter.dll - layout changed?")

    (staging / "VERSION").write_text(version + "\n")

    # swap in place: a half-extracted tree would leave nvim pointing at a broken dll
    shutil.rmtree(dest, ignore_errors=True)
    staging.rename(dest)
    print(f"installed {extracted} files to {dest}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", help="marketplace version to install (default: latest)")
    parser.add_argument("--dir", type=Path, default=DEFAULT_DIR, help=f"install root (default: {DEFAULT_DIR})")
    parser.add_argument("--status", action="store_true", help="print installed version and exit")
    parser.add_argument("--force", action="store_true", help="reinstall even if up to date")
    args = parser.parse_args()

    dest = args.dir.expanduser()
    current = installed_version(dest)

    if args.status:
        print(f"installed: {current or 'none'} ({dest})")
        print(f"dotnet:    {best_dotnet_major() or 'not found'}")
        return

    wanted = args.version or latest_version()
    if current == wanted and not args.force:
        print(f"vstuc {wanted} already installed at {dest}")
    else:
        install(dest, wanted)

    major = best_dotnet_major()
    if major < MIN_DOTNET_MAJOR:
        print(
            f"warning: newest .NET runtime found is {major or 'none'}, vstuc needs "
            f"{MIN_DOTNET_MAJOR}+. Install it with:\n"
            f"  curl -sSL https://dot.net/v1/dotnet-install.sh | bash -s -- --channel {MIN_DOTNET_MAJOR}.0 --runtime dotnet",
            file=sys.stderr,
        )


if __name__ == "__main__":
    main()
